# ╭──────────────────────────────────────────────────────────────────────╮
# │  🔑 .env.example: your template for the .env file                    │
# │                                                                      │
# │  1. Copy this file and name the copy exactly:  .env                  │
# │       Windows (PowerShell):  copy .env.example .env                  │
# │       Mac / Linux:           cp .env.example .env                    │
# │  2. Paste your key(s) after the = sign. No quotes, no spaces.        │
# │  3. SAVE the file. (Yes, really: this is the #1 setup problem!)      │
# │                                                                      │
# │  ⚠️ .env is listed in .gitignore, so your keys never get committed.  │
# │     Never paste keys into notebooks, screenshots or Udemy Q&A.       │
# ╰──────────────────────────────────────────────────────────────────────╯

# ── 🔑 API keys ─────────────────────────────────────────────────────────
# Required for the default setup: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: only if you swap providers (see setup/SWAP_PROVIDER.md)
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── 🧠 Models: "provider:model" ─────────────────────────────────────────
# Everyday steps (cheap and fast)
CHAT_MODEL=openai:gpt-5.4-mini
# Grading (week 5): the careful marker
SMART_MODEL=openai:gpt-5.5
# Reading handwriting (week 4): must support images
VISION_MODEL=openai:gpt-5.5
# Embeddings (week 2)
EMBEDDING_MODEL=openai:text-embedding-3-small

# ── 💰 Budget mode: true = every step uses CHAT_MODEL (cheapest) ────────
BUDGET_MODE=false

# ── 🔭 LangSmith tracing (we turn this on properly in week 5) ───────────
# Free account: https://smith.langchain.com/
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gradewise

# ── 🏠 Local models with Ollama (optional, free) ────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
