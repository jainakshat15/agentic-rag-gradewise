# ╭──────────────────────────────────────────────────────────────────────╮
# │  🔑 .env.example: your template for the .env file                    │
# │                                                                      │
# │  1. Copy this file and name the copy exactly:  .env                  │
# │       Windows (PowerShell):  copy .env.example .env                  │
# │       Mac / Linux:           cp .env.example .env                    │
# │  2. Paste your OpenRouter key after OPENROUTER_API_KEY= (no quotes,  │
# │     no spaces). That one key runs the whole course.                  │
# │  3. SAVE the file. (Yes, really: this is the #1 setup problem!)      │
# │                                                                      │
# │  ⚠️ .env is listed in .gitignore, so your keys never get committed.  │
# │     Never paste keys into notebooks, screenshots or Udemy Q&A.       │
# ╰──────────────────────────────────────────────────────────────────────╯

# ── 🔑 Your key: https://openrouter.ai/keys ─────────────────────────────
# One key for both cheap and free mode.
OPENROUTER_API_KEY=

# ── 💰 Which models: cheap | free | custom ──────────────────────────────
# cheap = openai/gpt-6-luna via OpenRouter: $0.10 / $0.50 per 1M tokens.
#         Needs a few dollars of OpenRouter credits.
# free  = openrouter/free: OpenRouter picks a free model for each call. $0,
#         no credits, but about 50 requests a day: use it with DATA_SIZE=small.
#         Results vary from call to call, and free providers may log or train
#         on prompts (fine for this course's fictional data, never real data).
# custom = whatever the *_MODEL lines below say
MODEL_MODE=cheap

# ── 📦 How much data: full | small ──────────────────────────────────────
# small = 2 PDFs, questions Q1–Q3, 2 students: for a quick, cheap run
DATA_SIZE=full

# ── 🧠 Custom only: "provider:model" (ignored unless MODEL_MODE=custom) ──
# Everyday steps
CHAT_MODEL=openrouter:openai/gpt-6-luna
# Grading (week 5). Stronger option: openrouter:openai/gpt-6.1-terra ($1 / $5 per 1M)
SMART_MODEL=openrouter:openai/gpt-6-luna
# Reading handwriting (week 4): must support images
VISION_MODEL=openrouter:openai/gpt-6-luna
# Embeddings (week 2)
EMBEDDING_MODEL=openrouter:openai/text-embedding-3-small

# Custom only: keys for providers you call directly (see setup/SWAP_PROVIDER.md)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── 🔭 LangSmith tracing (we turn this on properly in week 5) ───────────
# Free account: https://smith.langchain.com/
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gradewise

# ── 🏠 Local models with Ollama (optional, free) ────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
